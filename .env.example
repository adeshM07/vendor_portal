Main API — login / OTP (Swagger: https://dev.link2build.com/docs)

NEXT_PUBLIC_API_BASE_URL=https://dev.link2build.com/api/v1



# Rental API — vendor dashboard (Swagger: https://dev.link2build.com/rental/rental-docs)

NEXT_PUBLIC_RENTAL_API_BASE_URL=https://dev.link2build.com/rental/api/v1



# Local backend (uncomment when running API on localhost):

# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# NEXT_PUBLIC_RENTAL_API_BASE_URL=http://localhost:8000/rental/api/v1



# Live tracking — customer app polls GET /rentals/bookings/{booking_id}/tracking every 5s

# Testing (vendor): simulated 5–10 min route (default 8 min), pushes to backend for customer app
NEXT_PUBLIC_LIVE_TRACKING_MODE=dummy
NEXT_PUBLIC_TRACKING_USE_RENTAL_API=true
NEXT_PUBLIC_DEMO_ROUTE_DURATION_MINUTES=8
NEXT_PUBLIC_GPS_PUSH_INTERVAL_MS=10000

# NEXT_PUBLIC_TRACKING_API_BASE_URL=http://192.168.1.50:8000/api/v1


