# Material vendor dev login (localhost fixed OTP from backend seed)
# NEXT_PUBLIC_MATERIAL_VENDOR_OTP_PHONES=9822200001,9822200002,9822200003,9822200004,9822200005
# NEXT_PUBLIC_MATERIAL_VENDOR_FIXED_OTP=5678

# All three API URLs must point to the SAME environment (all dev OR all localhost).

NEXT_PUBLIC_API_BASE_URL=https://dev.link2build.com/api/v1



# Rental API — vendor dashboard (Swagger: https://dev.link2build.com/rental/rental-docs)

NEXT_PUBLIC_RENTAL_API_BASE_URL=https://dev.link2build.com/rental/api/v1



# Local backend (uncomment when running API on localhost):

# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# NEXT_PUBLIC_RENTAL_API_BASE_URL=http://localhost:8000/rental/api/v1

# NEXT_PUBLIC_MATERIAL_API_BASE_URL=http://localhost:8000/material/api/v1



# Material API — vendor material orders
# Swagger: http://localhost:8000/material/material-docs#/
NEXT_PUBLIC_MATERIAL_API_BASE_URL=http://localhost:8000/material/api/v1



# Live tracking — customer app polls GET /rentals/bookings/{booking_id}/tracking every 1s (testing)
#
# TESTING (default): simulated route ~8 min, PATCH coords to backend every 1s.
NEXT_PUBLIC_LIVE_TRACKING_MODE=dummy
NEXT_PUBLIC_TRACKING_USE_RENTAL_API=true
NEXT_PUBLIC_DEMO_ROUTE_DURATION_MINUTES=8
NEXT_PUBLIC_GPS_PUSH_INTERVAL_MS=1000
#
# FUTURE — real device GPS (not enabled yet; code is commented out in the app):
# NEXT_PUBLIC_LIVE_TRACKING_MODE=api

# NEXT_PUBLIC_TRACKING_API_BASE_URL=http://192.168.1.50:8000/api/v1


